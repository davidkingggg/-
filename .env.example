# Database
# SQLite (local development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Session encryption key (REQUIRED in production, must be 32+ characters)
# Generate with: openssl rand -base64 32
SESSION_PASSWORD=""

# Allow dev fallback session secret (set to "true" for local dev without SESSION_PASSWORD)
ALLOW_DEV_SESSION_SECRET="true"

# Node environment
NODE_ENV="production"
