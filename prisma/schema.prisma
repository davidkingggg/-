generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id                         String                       @id @default(uuid())
  name                       String
  type                       String?
  isPriority                 Boolean                      @default(false)
  standardLevel              String?
  afterSalesRisk             String?
  purchaseFrequency          String?
  notes                      String?
  isArchived                 Boolean                      @default(false)
  archivedAt                 DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  investigationRecords       InvestigationRecord[]
  purchaseExecutionProcess   PurchaseExecutionProcess[]
  quoteItems                 QuoteItem[]
  quoteSheets                QuoteSheet[]
  salesMaterials             SalesMaterial[]
  suppliers                  Supplier[]
  supplierDevelopmentProcess SupplierDevelopmentProcess[]
  supplierScores             SupplierScore[]
}

model Supplier {
  id                         String                       @id @default(uuid())
  name                       String
  categoryId                 String
  region                     String?
  companyType                String?
  source                     String?
  hasQuoted                  Boolean                      @default(false)
  hasVisited                 Boolean                      @default(false)
  willingToJoin              Boolean                      @default(false)
  cooperationWillingness     String?
  qualification              String?
  deliveryAbility            String?
  afterSalesAbility          String?
  paymentTerms               String?
  priceLevel                 String?
  recommendedLevel           String?
  riskSummary                String?
  notes                      String?
  nextFollowUpDate           DateTime?
  isArchived                 Boolean                      @default(false)
  archivedAt                 DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  investigationRecords       InvestigationRecord[]
  purchaseExecutionProcess   PurchaseExecutionProcess[]
  quoteItems                 QuoteItem[]
  quoteSheets                QuoteSheet[]
  category                   Category                     @relation(fields: [categoryId], references: [id])
  contacts                   SupplierContact[]
  supplierDevelopmentProcess SupplierDevelopmentProcess[]
  riskTags                   SupplierRiskTag[]
  scores                     SupplierScore[]
}

model SupplierContact {
  id         String    @id @default(uuid())
  supplierId String
  name       String
  position   String?
  phone      String?
  wechat     String?
  email      String?
  isPrimary  Boolean   @default(false)
  notes      String?
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
}

model Person {
  id                         String                       @id @default(uuid())
  name                       String
  department                 String?
  role                       String?
  phone                      String?
  email                      String?
  notes                      String?
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  purchaseSalesPersonProcess PurchaseExecutionProcess[]   @relation("PurchaseSalesPerson")
  purchaseOwnerProcess       PurchaseExecutionProcess[]   @relation("PurchaseOwner")
  purchaseRequesterProcess   PurchaseExecutionProcess[]   @relation("PurchaseRequester")
  devOwnerProcess            SupplierDevelopmentProcess[] @relation("DevOwner")
  supplierScores             SupplierScore[]
}

model QuoteSheet {
  id          String      @id @default(uuid())
  supplierId  String
  categoryId  String
  quoteDate   DateTime
  sourceType  String?
  quoteStage  String?
  rawText     String?
  notes       String?
  isArchived  Boolean     @default(false)
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quoteNumber String?     @unique
  title       String?
  items       QuoteItem[]
  category    Category    @relation(fields: [categoryId], references: [id])
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
}

model QuoteItem {
  id              String     @id @default(uuid())
  quoteSheetId    String
  supplierId      String
  categoryId      String
  compareKey      String
  productName     String
  model           String?
  unit            String?
  price           Decimal?
  includesTax     Boolean    @default(false)
  taxRate         Decimal?
  includesFreight Boolean    @default(false)
  minOrderQty     Int?
  deliveryTime    String?
  paymentTerms    String?
  warranty        String?
  priceNotes      String?
  isArchived      Boolean    @default(false)
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  category        Category   @relation(fields: [categoryId], references: [id])
  supplier        Supplier   @relation(fields: [supplierId], references: [id])
  quoteSheet      QuoteSheet @relation(fields: [quoteSheetId], references: [id])
}

model SupplierScore {
  id               String   @id @default(uuid())
  supplierId       String
  categoryId       String
  scorerId         String
  scoreDate        DateTime
  qualityScore     Decimal?
  priceScore       Decimal?
  deliveryScore    Decimal?
  afterSalesScore  Decimal?
  cooperationScore Decimal?
  paymentScore     Decimal?
  regionScore      Decimal?
  totalScore       Decimal?
  systemLevel      String?
  manualLevel      String?
  finalLevel       String?
  scoreReason      String?
  isArchived       Boolean  @default(false)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  scorer           Person   @relation(fields: [scorerId], references: [id])
  category         Category @relation(fields: [categoryId], references: [id])
  supplier         Supplier @relation(fields: [supplierId], references: [id])
}

model InvestigationRecord {
  id                String    @id @default(uuid())
  type              String
  supplierId        String
  categoryId        String
  date              DateTime
  location          String?
  participants      String?
  keyPoints         String?
  productHighlights String?
  priceInfo         String?
  qualificationInfo String?
  deliveryInfo      String?
  afterSalesInfo    String?
  risks             String?
  nextActions       String?
  recommendFollowUp Boolean   @default(true)
  notes             String?
  isArchived        Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  category          Category  @relation(fields: [categoryId], references: [id])
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
}

model SupplierDevelopmentProcess {
  id                  String    @id @default(uuid())
  supplierId          String
  categoryId          String
  currentStage        String
  ownerId             String
  priority            String?
  dueDate             DateTime?
  currentIssue        String?
  nextAction          String?
  needBossDecision    Boolean   @default(false)
  needSalesSupport    Boolean   @default(false)
  needBusinessSupport Boolean   @default(false)
  status              String
  notes               String?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  owner               Person    @relation("DevOwner", fields: [ownerId], references: [id])
  category            Category  @relation(fields: [categoryId], references: [id])
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
}

model PurchaseExecutionProcess {
  id                  String    @id @default(uuid())
  title               String
  supplierId          String
  categoryId          String
  requesterId         String
  ownerId             String
  salesPersonId       String?
  currentStage        String
  priority            String?
  dueDate             DateTime?
  currentIssue        String?
  nextAction          String?
  needBossDecision    Boolean   @default(false)
  needPaymentRequest  Boolean   @default(false)
  purchaseAmount      Decimal?
  contractNo          String?
  contractDate        DateTime?
  paymentRequestDate  DateTime?
  arrivalDate         DateTime?
  acceptanceDate      DateTime?
  invoiceDate         DateTime?
  invoiceNo           String?
  prepaymentAmount    Decimal?
  offsetAmount        Decimal?
  hasArrived          Boolean   @default(false)
  hasAccepted         Boolean   @default(false)
  hasInvoice          Boolean   @default(false)
  hasPrepaymentOffset Boolean   @default(false)
  status              String
  notes               String?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  salesPerson         Person?   @relation("PurchaseSalesPerson", fields: [salesPersonId], references: [id])
  owner               Person    @relation("PurchaseOwner", fields: [ownerId], references: [id])
  requester           Person    @relation("PurchaseRequester", fields: [requesterId], references: [id])
  category            Category  @relation(fields: [categoryId], references: [id])
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
}

model AdminTask {
  id          String    @id @default(uuid())
  title       String
  type        String
  priority    String?
  dueDate     DateTime?
  isRecurring Boolean   @default(false)
  status      String
  completedAt DateTime?
  notes       String?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SalesMaterial {
  id                   String    @id @default(uuid())
  title                String
  categoryId           String
  targetAudience       String?
  coreSellingPoints    String?
  priceAdvantage       String?
  supplierAdvantage    String?
  qualificationSupport String?
  deliveryAdvantage    String?
  afterSalesAdvantage  String?
  riskNotice           String?
  formalText           String?
  isArchived           Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  category             Category  @relation(fields: [categoryId], references: [id])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  notes     String?
  updatedAt DateTime @updatedAt
}

model Attachment {
  id          String    @id @default(uuid())
  relatedType String
  relatedId   String
  fileName    String
  filePath    String
  fileType    String?
  notes       String?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model RiskTag {
  id        String            @id @default(uuid())
  name      String            @unique
  color     String?
  notes     String?
  createdAt DateTime          @default(now())
  suppliers SupplierRiskTag[]
}

model SupplierRiskTag {
  supplierId String
  riskTagId  String
  riskTag    RiskTag  @relation(fields: [riskTagId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@id([supplierId, riskTagId])
}
